# --- MySQL ---
MYSQL_DATABASE=agrivision
MYSQL_USER=agrivision
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_HOST=mysql
MYSQL_PORT=3306

# SQLAlchemy connection string used by the backend
DATABASE_URL=mysql+pymysql://agrivision:change_me@mysql:3306/agrivision

# --- Backend ---
CORS_ORIGINS=http://localhost:5173
SEGMENTATION_BACKEND=classical_cv
# MODEL_CHECKPOINT_PATH and STORAGE_ROOT default to models_store/classifier_best.pt
# and storage/ (relative to the backend process's working directory — /app in
# Docker, backend/ in a local dev run) — only set these to override that.
LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
