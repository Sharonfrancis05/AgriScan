# Copy to docker-compose.override.yml for local development with hot reload.
# docker compose picks this up automatically alongside docker-compose.yml.
services:
  backend:
    build:
      target: dev
    command: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload
    volumes:
      - ./backend/app:/app/app
      - ./backend/models_store:/app/models_store
      - ./storage:/app/storage

  frontend:
    build:
      target: dev
    command: npm run dev -- --host 0.0.0.0
    volumes:
      - ./frontend/src:/app/src
      - ./frontend/index.html:/app/index.html
    ports:
      - "5173:5173"
    environment:
      VITE_API_BASE_URL: ${VITE_API_BASE_URL}
